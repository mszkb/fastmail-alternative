# Real provider account for `make test-live` (apps/server-php/tests/Live).
# Copy to .env.live (never commit it) and use a dedicated test account:
# each run sends one mail to itself and deletes it again.
# Values with special characters in single quotes.
LIVE_MAIL_USER='test@gmx.de'
LIVE_MAIL_PASSWORD=''
LIVE_IMAP_HOST=imap.gmx.net
LIVE_IMAP_PORT=993
LIVE_SMTP_HOST=mail.gmx.net
LIVE_SMTP_PORT=587
