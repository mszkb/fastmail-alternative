# Real provider account for `make test-live` (apps/server-php/tests/Live)
# and `make test-account` (adds it to a running instance).
# Copy to .env.live (never commit it) and use a dedicated test account:
# each test run sends one mail to itself and deletes it again.
# Values with special characters in single quotes.
#
# Any provider with password login works. LIVE_MAIL_USER is the login for
# IMAP and SMTP and the sender address, so login and address must match.
# Ports 993/465 use TLS, 143/587 STARTTLS. Hosts as in the account presets
# (packages/shared/src/provider-presets.ts).

# GMX - turn on IMAP first: Webmail > Einstellungen > POP3/IMAP Abruf.
# Web.de: same steps, imap.web.de / smtp.web.de.
LIVE_MAIL_USER='test@gmx.de'
LIVE_MAIL_PASSWORD=''
LIVE_IMAP_HOST=imap.gmx.net
LIVE_IMAP_PORT=993
LIVE_SMTP_HOST=mail.gmx.net
LIVE_SMTP_PORT=587

# Gmail - app password (needs 2-step verification): myaccount.google.com/apppasswords.
# Deleting in INBOX only removes the label: test mails stay in "All Mail".
# LIVE_IMAP_HOST=imap.gmail.com
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=smtp.gmail.com
# LIVE_SMTP_PORT=465

# Yahoo - app password: Account security > Generate app password.
# LIVE_IMAP_HOST=imap.mail.yahoo.com
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=smtp.mail.yahoo.com
# LIVE_SMTP_PORT=465

# iCloud - app-specific password: account.apple.com > Sign-In and Security.
# LIVE_IMAP_HOST=imap.mail.me.com
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=smtp.mail.me.com
# LIVE_SMTP_PORT=587

# Fastmail - app password with IMAP/SMTP access: Settings > Privacy & Security.
# LIVE_IMAP_HOST=imap.fastmail.com
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=smtp.fastmail.com
# LIVE_SMTP_PORT=465

# Posteo - normal password.
# LIVE_IMAP_HOST=posteo.de
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=posteo.de
# LIVE_SMTP_PORT=465

# mailbox.org - normal password.
# LIVE_IMAP_HOST=imap.mailbox.org
# LIVE_IMAP_PORT=993
# LIVE_SMTP_HOST=smtp.mailbox.org
# LIVE_SMTP_PORT=465

# Not supported: Outlook.com / Microsoft 365 (OAuth only, no password
# login), Proton and Tuta (no IMAP without bridge).
