# Caddy in front of web (static PWA) and php (php-fpm for /api/*).
{
	# Slow-client protection (roadmap 6.4): request headers and bodies (e.g.
	# a 10 MB attachment upload) must arrive in time.
	servers {
		timeouts {
			read_header 30s
			read_body 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# HSTS for the whole origin; app headers come from the web container
	# (apps/web/nginx.conf), api headers from the PHP app itself.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}

	# Every /api/* request goes to the Slim front controller in the php
	# container (FastCGI). The files live only there, so no try_files:
	# REQUEST_URI keeps the original path for the router.
	handle /api/* {
		rewrite * /index.php?{query}
		reverse_proxy php:9000 {
			transport fastcgi {
				root /app/public
				split .php
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
