{
	# Slow-client protection (roadmap 6.4): request headers and bodies (e.g.
	# a 10 MB attachment upload) must arrive in time; the api enforces its
	# own limit as well (REQUEST_TIMEOUT_MS).
	servers {
		timeouts {
			read_header 30s
			read_body 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Security headers (roadmap 6.4). App CSP and api headers come from the
	# api itself (apps/api/src/web-app.ts, security/headers.ts); caddy
	# adds HSTS for the whole origin (ignored by browsers on plain-HTTP
	# instances with DOMAIN=:80) and fills in nosniff where missing.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		-Server
	}

	# The api serves both /api/* and the static PWA.
	reverse_proxy api:3001
}
