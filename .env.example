# Copy to .env and fill in values, or run: node scripts/setup-env.mjs
# (generates MASTER_KEY, VAPID keys and a random POSTGRES_PASSWORD)

# Site address for caddy. Use your domain for automatic Let's Encrypt TLS,
# or ":80" for plain HTTP on a local network (no TLS, e.g. for testing).
DOMAIN=:80

# Master key for envelope encryption of credentials and mail contents
# (32 bytes, base64). WARNING: if this key is lost, all encrypted data
# (mails, provider credentials) is unrecoverable. Back it up separately
# from the database backup!
MASTER_KEY=

# Master key version for key rotation (see docs/process/key-rotation.md).
# Only change together with a rotation.
MASTER_KEY_ID=v1

# Web Push VAPID keys (P-256, base64url; scripts/setup-env.mjs generates
# them). Empty = push notifications disabled. Changing the keys invalidates
# all existing browser subscriptions (users must re-enable notifications).
# VAPID_SUBJECT: contact for the push services (mailto: or https: URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# PostgreSQL credentials.
POSTGRES_USER=mail
POSTGRES_PASSWORD=
POSTGRES_DB=mail
# Host port of the loopback-only PostgreSQL port (maintenance/SSH tunnel);
# change it when the host already runs a PostgreSQL on 5432.
# POSTGRES_HOST_PORT=5432

# Periodic IMAP sync per account in seconds (worker, default 120). Fallback
# next to IMAP IDLE.
SYNC_INTERVAL_SECONDS=120
# Minimum gap between two IDLE-triggered syncs of the same folder (seconds,
# default 10, 0 = off): bursts of IDLE events cause one sync, not many.
SYNC_MIN_INTERVAL_SECONDS=10

# IMAP IDLE for the INBOX: one connection per active account, new mail is
# synced within seconds. 0 disables IDLE (polling only). The connection limit
# caps how many accounts use IDLE (default 50).
IMAP_IDLE=1
IMAP_IDLE_MAX_CONNECTIONS=50

# Jobs the worker runs in parallel (default 4); at most one per account, so a
# slow provider never blocks the other accounts.
WORKER_CONCURRENCY=4
# Jobs (= IMAP connections) running at the same time against one IMAP host,
# across all accounts at that provider (default 4). IDLE connections are not
# counted (see IMAP_IDLE_MAX_CONNECTIONS). Lower it if a provider complains
# about too many connections.
IMAP_MAX_CONNECTIONS_PER_HOST=4

# Raw mails above this size (bytes, default 20 MB) are not stored; the
# message shows headers and preview only. Each large mail needs up to ~5x its
# size in worker RAM while it is processed (see docker-compose.yml mem_limit).
MAX_RAW_MESSAGE_BYTES=20971520

# Attachments to send (api, bytes): per uploaded file (default 10 MB) and all
# attachments of one message together (default 14 MB - base64 adds a third,
# so the copy in "Sent" stays below MAX_RAW_MESSAGE_BYTES). An upload is held
# in api RAM while it is encrypted (~4x its size, see mem_limit 192m).
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS_TOTAL_BYTES=14680064
# Uploads received by the api at the same time (each ~4x MAX_ATTACHMENT_BYTES in RAM, default 2).
MAX_CONCURRENT_UPLOADS=2

# Cleanup (worker, roadmap 5.5): how often the cleanup job runs (hours,
# default 6) and how long data is kept: finished / failed jobs (days, 7 / 30),
# uploads never attached to a message (hours, 168 = 7 days, so a message
# written offline with attachments can still be sent later), sent or failed outbox
# entries (days, 30) and the grace period before unreferenced files in the
# mail-data volume are deleted (hours, 24).
CLEANUP_INTERVAL_HOURS=6
JOB_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=30
UPLOAD_RETENTION_HOURS=168
OUTBOX_RETENTION_DAYS=30
ORPHAN_FILE_GRACE_HOURS=24

# Log level (debug | info | warn | error), api and worker.
LOG_LEVEL=info

# Prometheus metrics at /api/metrics: empty = endpoint disabled (404).
# When set, scraping requires: Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# Optional setup code for the first-run setup page. Empty = the api logs a
# random code once while no user exists: docker compose logs api
SETUP_TOKEN=

# Own mail server in the LAN/home network (private IP addresses): 1 = allow
# private/internal mail hosts (api + worker). WARNING: disables the SSRF
# protection for mail hosts - only set it when you really need it. STARTTLS
# and certificate checks stay mandatory (the server needs a valid certificate).
#MAIL_ALLOW_PRIVATE_HOSTS=1
