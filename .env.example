# Copy to .env and fill in values, or run: node scripts/setup-env.mjs
# (generates MASTER_KEY, VAPID keys and a random POSTGRES_PASSWORD)

# Site address for caddy. Use your domain for automatic Let's Encrypt TLS,
# or ":80" for plain HTTP on a local network (no TLS, e.g. for testing).
DOMAIN=:80

# Master key for envelope encryption of credentials and mail contents
# (32 bytes, base64). WARNING: if this key is lost, all encrypted data
# (mails, provider credentials) is unrecoverable. Back it up separately
# from the database backup!
MASTER_KEY=

# Master key version for key rotation (see docs/process/key-rotation.md).
# Only change together with a rotation.
MASTER_KEY_ID=v1

# Web Push VAPID keys (P-256, base64url; scripts/setup-env.mjs generates
# them). Empty = push notifications disabled. Changing the keys invalidates
# all existing browser subscriptions (users must re-enable notifications).
# VAPID_SUBJECT: contact for the push services (mailto: or https: URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# PostgreSQL credentials.
POSTGRES_USER=mail
POSTGRES_PASSWORD=
POSTGRES_DB=mail

# Periodic IMAP sync per account in seconds (worker, default 120). Polling
# until IMAP IDLE is implemented.
SYNC_INTERVAL_SECONDS=120

# Jobs the worker runs in parallel (default 4); at most one per account, so a
# slow provider never blocks the other accounts.
WORKER_CONCURRENCY=4

# Raw mails above this size (bytes, default 20 MB) are not stored; the
# message shows headers and preview only. Each large mail needs up to ~5x its
# size in worker RAM while it is processed (see docker-compose.yml mem_limit).
MAX_RAW_MESSAGE_BYTES=20971520

# Attachments to send (api, bytes): per uploaded file (default 10 MB) and all
# attachments of one message together (default 14 MB - base64 adds a third,
# so the copy in "Sent" stays below MAX_RAW_MESSAGE_BYTES). An upload is held
# in api RAM while it is encrypted (~4x its size, see mem_limit 192m).
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS_TOTAL_BYTES=14680064

# Log level (debug | info | warn | error), api and worker.
LOG_LEVEL=info

# Prometheus metrics at /api/metrics: empty = endpoint disabled (404).
# When set, scraping requires: Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
