# Copy to .env and fill in values, or run: ./scripts/setup-env.sh
# (generates MASTER_KEY, VAPID keys and a random MARIADB_PASSWORD)

# Site address for caddy. Use your domain for automatic Let's Encrypt TLS,
# or ":80" for plain HTTP on a local network (no TLS, e.g. for testing).
DOMAIN=:80

# Secure flag of the session cookie: empty = automatic (secure unless
# DOMAIN=:80). Set 1 behind an own TLS reverse proxy that forwards to
# caddy on :80, so the cookie is still sent over HTTPS only.
#COOKIE_SECURE=1

# Master key for envelope encryption of credentials and mail contents
# (32 bytes, base64). WARNING: if this key is lost, all encrypted data
# (mails, provider credentials) is unrecoverable. Back it up separately
# from the database backup!
MASTER_KEY=

# Master key version for key rotation (see docs/process/key-rotation.md).
# Only change together with a rotation.
MASTER_KEY_ID=v1

# Web Push VAPID keys (P-256, base64url; scripts/setup-env.sh generates
# them). Empty = push notifications disabled. Changing the keys invalidates
# all existing browser subscriptions (users must re-enable notifications).
# VAPID_SUBJECT: contact for the push services (mailto: or https: URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Sign-in with Google / Microsoft (OAuth2, docs/operations/oauth.md).
# Each instance registers its own OAuth app; empty = the button is hidden and
# such accounts use an app password (Google) or cannot be added (Microsoft).
# Redirect URI to register at the provider: {PUBLIC_URL}/api/oauth/callback.
# PUBLIC_URL defaults to https://DOMAIN (set it when DOMAIN=:80 behind an own
# TLS proxy).
#PUBLIC_URL=https://mail.example.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# Microsoft tenant: common (work and personal accounts), consumers,
# organizations or a tenant id.
OAUTH_MICROSOFT_TENANT=common

# MariaDB password of the app user (MARIADB_USER/MARIADB_DATABASE default
# to "mail").
MARIADB_PASSWORD=

# Host ports of caddy (default 80/443).
#HTTP_PORT=80
#HTTPS_PORT=443

# Periodic IMAP sync per account in seconds (worker, default 120). Fallback
# next to IMAP IDLE.
SYNC_INTERVAL_SECONDS=120
# Minimum gap between two IDLE-triggered syncs of the same folder (seconds,
# default 10, 0 = off): bursts of IDLE events cause one sync, not many.
SYNC_MIN_INTERVAL_SECONDS=10

# IMAP IDLE for the INBOX: one connection per active account, new mail is
# synced within seconds. 0 disables IDLE (polling only). The connection limit
# caps how many accounts use IDLE (default 50).
IMAP_IDLE=1
IMAP_IDLE_MAX_CONNECTIONS=50

# Jobs (= IMAP connections) running at the same time against one IMAP host,
# across all accounts at that provider (default 4). IDLE connections are not
# counted (see IMAP_IDLE_MAX_CONNECTIONS). Lower it if a provider complains
# about too many connections.
IMAP_MAX_CONNECTIONS_PER_HOST=4

# Raw mails above this size (bytes, default 20 MB) are not stored; the
# message shows headers and preview only. A large mail needs a multiple of
# its size in worker RAM while it is processed (see docker-compose.yml mem_limit).
MAX_RAW_MESSAGE_BYTES=20971520

# Attachments to send (bytes): per uploaded file (default 10 MB) and all
# attachments of one message together (default 14 MB - base64 adds a third,
# so the copy in "Sent" stays below MAX_RAW_MESSAGE_BYTES).
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS_TOTAL_BYTES=14680064

# Cleanup: how often the cleanup job runs (hours, default 6) and how long
# data is kept: finished / failed jobs (days, 7 / 30), uploads never attached
# to a message (hours, 168 = 7 days, so a message written offline with
# attachments can still be sent later), sent or failed outbox entries (days,
# 30) and the grace period before unreferenced files in the mail-data volume
# are deleted (hours, 24).
CLEANUP_INTERVAL_HOURS=6
JOB_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=30
UPLOAD_RETENTION_HOURS=168
OUTBOX_RETENTION_DAYS=30
ORPHAN_FILE_GRACE_HOURS=24

# scripts/backup.sh: backups older than this many days are deleted
# (default 14, 0 = keep all).
BACKUP_KEEP_DAYS=14

# Log level (debug | info | warn | error), php and worker.
LOG_LEVEL=info

# Prometheus metrics at /api/metrics: empty = endpoint disabled (404).
# When set, scraping requires: Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# Optional setup code for the first-run setup page. Empty = a random code is
# generated while no user exists; print a new one with:
# docker compose exec php php bin/setup-code.php
SETUP_TOKEN=

# Own mail server in the LAN/home network (private IP addresses): 1 = allow
# private/internal mail hosts (php + worker). WARNING: disables the SSRF
# protection for mail hosts - only set it when you really need it. STARTTLS
# and certificate checks stay mandatory (the server needs a valid certificate).
#MAIL_ALLOW_PRIVATE_HOSTS=1

# Mail ports besides the standard ones (IMAP 143/993, SMTP 25/465/587/2525),
# comma-separated - e.g. an own server on a non-standard port. Other ports
# are refused (no port scans of other hosts via a mail account).
#MAIL_EXTRA_PORTS=1143,10465

# Optional: signed release images instead of the local build (see
# docs/operations/upgrade.md). All docker compose commands then use them;
# an own docker-compose.override.yml must be appended to COMPOSE_FILE.
# scripts/upgrade.sh refuses to run with release images (manual upgrade).
#COMPOSE_FILE=docker-compose.yml:docker-compose.release.yml
#FMA_VERSION=0.1.0
#FMA_IMAGE_PREFIX=ghcr.io/mszkb
